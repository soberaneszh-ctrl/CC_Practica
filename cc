    "def load_emissions(path):\n",
    "\n",
    "    # Leer archivo CSV\n",
    "    path = Path(path)\n",
    "\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f\"No se encontró el archivo: {path}\"\n",
    "        )\n",
    "\n",
    "    data = pd.read_csv(path)\n",
    "\n",
    "    # Comprobar columnas necesarias\n",
    "    required = {\"year\", \"scenario\", \"specie\", \"emissions\"}\n",
    "    missing = required.difference(data.columns)\n",
    "\n",
    "    if missing:\n",
    "        raise ValueError(f\"Faltan columnas: {missing}\")\n",
    "\n",
    "    # Limpiar y convertir datos\n",
    "    data = data.copy()\n",
    "\n",
    "    data[\"year\"] = pd.to_numeric(\n",
    "        data[\"year\"], errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    data[\"emissions\"] = pd.to_numeric(\n",
    "        data[\"emissions\"], errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "    data[\"scenario\"] = (\n",
    "        data[\"scenario\"].astype(str).str.lower().str.strip()\n",
    "    )\n",
    "\n",
    "    data[\"specie\"] = data[\"specie\"].astype(str).str.strip()\n",
    "\n",
    "    # Eliminar registros incompletos\n",
    "    data = data.dropna(subset=[\"year\", \"emissions\"])\n",
    "\n",
    "    data[\"year\"] = data[\"year\"].astype(int)\n",
    "\n",
    "    # Revisar duplicados\n",
    "    if data.duplicated(\n",
    "        [\"year\", \"scenario\", \"specie\"]\n",
    "    ).any():\n",
    "        raise ValueError(\"Existen registros duplicados.\")\n",
    "\n",
    "    return data\n",
    "\n",
    "\n",
    "print(\"Función load_emissions lista.\")"
   ]
